{
  "name": "hoc-english",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/ui": "~58.0.30",
    "@hono/node-server": "^2.1.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.6",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "hono": "^4.13.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "~24.19.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p server",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "server": "node server/main.ts",
    "test:server": "node --test \"server/**/*.test.ts\"",
    "typecheck:server": "tsc -p server",
    "drive": "node scripts/drive.mjs",
    "e2e": "playwright test",
    "test:drive": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/server/",
      "<rootDir>/scripts/",
      "<rootDir>/e2e/",
      "<rootDir>/.claude/",
      "<rootDir>/dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/dist/",
      "<rootDir>/android/",
      "<rootDir>/ios/"
    ]
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
