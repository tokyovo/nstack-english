{
  "expo": {
    "name": "Học Tiếng Anh",
    "slug": "hoc-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hocenglish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.hocenglish"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F6F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.INTERNET", "android.permission.RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "app.hocenglish"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "vi"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121816",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "$(PRODUCT_NAME) dùng micrô để nghe và chấm câu tiếng Anh bạn nói. Micrô chỉ bật khi bạn bấm “Nói”.",
          "speechRecognitionPermission": "$(PRODUCT_NAME) dùng nhận dạng giọng nói để kiểm tra câu tiếng Anh bạn nói. Giọng nói không được ứng dụng lưu lại.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      "./plugins/with-android-no-backup"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
